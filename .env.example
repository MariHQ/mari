# Mari — environment overrides for docker compose.
# Copy to .env: `cp .env.example .env`. Every variable is optional; the
# defaults in docker-compose.yml + server/config.py give a working local
# deployment. These override values from mari.toml (see server/config.py).

# --- Database -----------------------------------------------------------
# Postgres connection URL (needs the pgvector extension available).
# docker-compose.yml already sets this to the bundled db service; set it
# here only to point at an external/cloud Postgres instead.
#MARI_DB=postgresql://mari:mari@db:5432/mari_cloud

# --- Ollama (optional LLM features) --------------------------------------
# Where the ollama API lives. Default in compose targets ollama running on
# the docker HOST. Use http://ollama:11434 with the compose ollama service.
# If unreachable, chat/refine/fact-check fall back gracefully.
#MARI_OLLAMA_HOST=http://host.docker.internal:11434

# --- OAuth sign-in (optional) --------------------------------------------
# GitHub OAuth app credentials (callback under /auth on your public URL).
#MARI_GITHUB_CLIENT_ID=
#MARI_GITHUB_CLIENT_SECRET=
# Google OAuth client credentials.
#MARI_GOOGLE_CLIENT_ID=
#MARI_GOOGLE_CLIENT_SECRET=

# One-click login escape hatch. Enabled by default for this shared demo; set
# false if a future deployment should require credentials.
#MARI_AUTH_BYPASS=false

# --- S3 site publishing (optional) ---------------------------------------
# Bucket for published site builds; leave unset to serve from /sites only.
# With this set, Publish uploads the build and the site is live; without it,
# Publish builds locally and says so.
#MARI_S3_BUCKET=mari-guru-web

# CloudFront distribution to invalidate after an upload. Without it a deploy
# succeeds and visitors keep seeing the previous build until the CDN expires it
# on its own, which looks exactly like a deploy that did not work.
#MARI_CLOUDFRONT_DISTRIBUTION_ID=E3JM12N6UI9HL8

# AWS credentials come from the standard chain: an instance/task role in
# production, or ~/.aws mounted into the container for local work (see the
# volumes and AWS_PROFILE lines in docker-compose.yml). Do not put access keys
# in this file.
#AWS_PROFILE=mari
#AWS_REGION=us-east-1

# --- Server ---------------------------------------------------------------
# Comma-separated CORS origins. Not needed for the bundled nginx setup
# (same-origin proxy); set when the web app is hosted on another domain.
#MARI_CORS_ORIGINS=http://localhost:8080

# --- Repo audit ------------------------------------------------------------
# The audit scans a connected GitHub source. Connect one in Settings →
# Sources (uses MARI_GITHUB_TOKEN above); no local path to configure.

# --- Config file ------------------------------------------------------------
# Path to a mari.toml to load before env overrides apply.
#MARI_CONFIG=/app/server/mari.toml
