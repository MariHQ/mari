{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "api": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "const": 1,
          "description": "Mari v0.1.3 uses one API replica with its ReadWriteOnce data volume."
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "const": true,
              "description": "The self-contained v0.1.3 chart always persists application data."
            }
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "affinity": {"type": "object"},
        "tolerations": {
          "type": "array",
          "items": {"type": "object"}
        },
        "topologySpreadConstraints": {
          "type": "array",
          "items": {"type": "object"}
        }
      }
    },
    "web": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "const": 1,
          "description": "Mari v0.1.3 supports exactly one web replica."
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "affinity": {"type": "object"},
        "tolerations": {
          "type": "array",
          "items": {"type": "object"}
        },
        "topologySpreadConstraints": {
          "type": "array",
          "items": {"type": "object"}
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string",
          "description": "Recommended: name of a Secret containing only POSTGRES_PASSWORD and MARI_DB."
        },
        "databasePassword": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "description": "Required when existingSecret is empty. Use a long URL-safe value; never commit it."
        }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "const": true,
          "description": "The self-contained v0.1.3 chart always deploys PostgreSQL/pgvector."
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "affinity": {"type": "object"},
        "tolerations": {
          "type": "array",
          "items": {"type": "object"}
        },
        "topologySpreadConstraints": {
          "type": "array",
          "items": {"type": "object"}
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "host": {
          "type": "string",
          "description": "Optional customer-owned DNS hostname. Blank creates a hostless ingress."
        }
      }
    }
  }
}
