    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jscpd": "^5.0.12",
    "knip": "^6.27.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.0.3"
  }
