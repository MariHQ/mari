{
  "name": "mari-cloud-web-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:css": "stylelint \"src/**/*.css\"",
    "knip": "knip",
    "check": "tsc --noEmit && eslint src && stylelint \"src/**/*.css\" && knip && jscpd src --min-tokens 45 --silent",
    "dup": "jscpd src --min-tokens 45 --silent"
  },
  "dependencies": {
    "@fontsource/lora": "^5.1.0",
    "@fontsource/playfair-display": "^5.1.0",
    "@fontsource/source-sans-3": "^5.1.0",
